---
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';
import Layout from '../layouts/Layout.astro';

// Deterministic starfield so builds are stable.
let seed = 20261028;
const rand = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const stars = Array.from({ length: 110 }, () => ({
  x: (rand() * 100).toFixed(2),
  y: (Math.pow(rand(), 0.8) * 100).toFixed(2),
  r: rand() > 0.8 ? 1 : 0.6,
  o: (0.3 + rand() * 0.7).toFixed(2),
}));

// Galleries only render when matching screenshots exist in /public/images.
const imgDir = path.join(process.cwd(), 'public', 'images');
const files = fs.existsSync(imgDir) ? fs.readdirSync(imgDir).sort() : [];
async function gallery(prefix: string) {
  const re = new RegExp(`^${prefix}-.*\\.png$`, 'i');
  return Promise.all(
    files
      .filter((f) => re.test(f))
      .map(async (f) => {
        const { width, height } = await sharp(path.join(imgDir, f)).metadata();
        return { src: `/images/${f}`, width, height };
      }),
  );
}
const reportforge = await gallery('reportforge');
const jobEvaluator = await gallery('job-evaluator');

const jobs = [
  {
    role: 'Senior Technical Program Manager',
    org: 'Albany Medical Center',
    dates: '2023–present',
    intro: 'Lead concurrent enterprise programs, $1M–$10M+, across a four-hospital health system, and was given larger, higher-risk programs each year.',
    bullets: [
      ['UKG Workforce Management:', 'leading 7 of 11 workstreams, 150+ participants, seven-figure budget.'],
      ['StrataJazz Cost Accounting:', '200+ integrations across four hospitals, delivered on schedule.'],
      ['Workday Supply Chain & Finance:', 'took over 90+ integrations as a new hire, including the highest-risk ones, and drove them to a clean go-live.'],
      ['Epic Willow:', 'authored a seven-figure business case that leadership adopted.'],
      ['', 'Run the operating rhythm: plans, risk and issue logs, decision records, and executive status reporting.'],
      ['', 'Coordinate clinical, IT, finance, HR, supply chain, and vendors, none of whom report to me.'],
    ],
  },
  {
    role: 'Technical Support Manager / IT Operations',
    org: 'MyComplianceOffice',
    dates: '2014–2020',
    bullets: [
      ['', 'Led global support and client implementations for a compliance platform used by banks and investment firms.'],
      ['', 'Managed a team of 5 across the US, Ireland, and Hong Kong, with 96%+ client satisfaction.'],
      ['', 'Built the client portal, documentation library, and training program from scratch.'],
    ],
  },
  {
    role: 'Enterprise Software Sales',
    org: 'IgniteTech & Uzabase',
    dates: '2021–2022',
    bullets: [
      ['', "Worked enterprise deals end to end with executive, legal, and technical stakeholders. It taught me the buyer's side of every implementation I've run since."],
    ],
  },
  {
    role: 'Digital Marketing & CRM Leadership',
    org: '',
    dates: '2002–2014',
    bullets: [
      ['', 'Led full Salesforce and Microsoft Dynamics implementations, from requirements through user adoption.'],
    ],
  },
];

const skills = [
  ['Program delivery', ['Enterprise program management', 'Multi-workstream delivery', 'Risk, issue & dependency management', 'Executive reporting', 'Business cases', 'Vendor coordination', 'Agile & waterfall']],
  ['AI & building', ['AI product delivery', 'LLM applications (Claude API)', 'AI verification & guardrails', 'Test harnesses', 'AI-assisted development', 'Rapid prototyping']],
  ['Platforms & tools', ['Workday', 'UKG', 'StrataJazz', 'Salesforce', 'Microsoft Dynamics', 'Jira', 'Smartsheet', 'MS Project', 'Confluence', 'Supabase', 'Vercel']],
];
---

<Layout
  title="Darryn Cooke | Technical Program Manager who builds AI people can trust"
  description="Technical Program Manager running $1M–$10M+ technology programs across a four-hospital health system, and building AI products of his own. Focus: the gap between “the AI can do it” and “we can rely on it.”"
>
  <svg class="sprite" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="sun-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffe65a"></stop>
        <stop offset="0.5" stop-color="#ff783c"></stop>
        <stop offset="1" stop-color="#ff2e88"></stop>
      </linearGradient>
      <mask id="sun-stripes">
        <rect width="100" height="100" fill="#fff"></rect>
        <rect x="0" y="55" width="100" height="1.2" fill="#000"></rect>
        <rect x="0" y="60.5" width="100" height="1.9" fill="#000"></rect>
        <rect x="0" y="66.5" width="100" height="2.7" fill="#000"></rect>
        <rect x="0" y="73" width="100" height="3.6" fill="#000"></rect>
        <rect x="0" y="80.5" width="100" height="4.6" fill="#000"></rect>
        <rect x="0" y="89" width="100" height="5.8" fill="#000"></rect>
      </mask>
      <symbol id="sun" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="48" fill="url(#sun-fill)" mask="url(#sun-stripes)"></circle>
      </symbol>
    </defs>
  </svg>

  <a class="skip" href="#work">Skip to content</a>

  <header class="nav">
    <div class="wrap">
      <a class="logo" href="#top" aria-label="Darryn Cooke, home">DC</a>
      <nav aria-label="Primary">
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#work">Work</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#skills">Skills</a></li>
          <li><a class="btn" href="/Darryn_Cooke_Resume.pdf" download>Resume</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="name">
      <div class="sky"></div>
      <svg class="stars" aria-hidden="true">
        {stars.map((s) => <circle cx={`${s.x}%`} cy={`${s.y}%`} r={s.r} fill="#fff" opacity={s.o} />)}
      </svg>
      <div class="floor" aria-hidden="true">
        <div class="plane"><i></i></div>
      </div>

      <div class="wrap hero-grid">
        <div>
          <h1 id="name">Darryn Cooke</h1>
          <p class="tagline">Technical Program Manager who builds AI people can trust.</p>
          <p class="lede">
            I run $1M–$10M+ technology programs across a four-hospital health system, and I design and ship AI
            products of my own. My focus is the gap between "the AI can do it" and "we can rely on it."
          </p>
          <div class="cta">
            <a class="btn primary" href="#work">See my work</a>
            <a class="btn" href="/Darryn_Cooke_Resume.pdf" download>Download resume</a>
            <a class="btn" href="https://linkedin.com/in/darryncooke" rel="noopener">LinkedIn →</a>
          </div>
        </div>
        <div class="portrait">
          <img
            src="/images/darryn-cooke-neon-headshot-900.jpg"
            srcset="/images/darryn-cooke-neon-headshot-600.jpg 600w, /images/darryn-cooke-neon-headshot-900.jpg 900w"
            sizes="(max-width: 900px) 80vw, 460px"
            width="900"
            height="900"
            alt="Darryn Cooke smiling, in front of a neon synthwave sunset"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <div class="lower">
      <section class="stats wrap" aria-label="Highlights">
        <ul>
          <li><strong>20</strong><span>years enterprise delivery</span></li>
          <li><strong>$1M–$10M+</strong><span>programs</span></li>
          <li><strong>500+</strong><span>system integrations</span></li>
          <li><strong>3</strong><span>AI reports in production</span></li>
        </ul>
      </section>

      <div class="wrap divider" aria-hidden="true"><svg class="sun"><use href="#sun"></use></svg></div>

      <section class="block wrap about" id="about" aria-labelledby="about-title">
        <h2 class="title" id="about-title">About</h2>
        <p>
          I've spent 20 years where technology meets the business: running client implementations for a compliance
          software company, selling enterprise software, and now leading Workday, UKG, and StrataJazz programs across a
          four-hospital health system. The common thread is getting complex systems live, with people who don't report
          to me, against deadlines that don't move.
        </p>
        <p>
          In 2026 I started building with AI myself. Not to become an engineer, but to learn what it takes to make AI
          dependable enough for finance, healthcare, and compliance work. ReportForge is the result. You get a program
          manager who has shipped AI hands-on and knows where it breaks.
        </p>
        <p class="aside">
          Off the clock, I've spent 15 years officiating high school and college basketball: fast calls, under
          pressure, with everyone watching.
        </p>
      </section>

      <div class="wrap divider" aria-hidden="true"><svg class="sun"><use href="#sun"></use></svg></div>

      <section class="block wrap" id="work" aria-labelledby="work-title">
        <h2 class="title" id="work-title">Work</h2>

        <article class="card case" aria-labelledby="rf">
          <h3 class="case-title" id="rf"><small>Case study 1</small>ReportForge</h3>
          <dl class="rows">
            <div class="row">
              <dt>Problem</dt>
              <dd>
                AI can write a financial report in seconds, but it will sometimes invent a number. In finance, one
                made-up figure ruins trust in the whole report. That's the main thing holding companies back from
                using AI for real work.
              </dd>
            </div>
            <div class="row">
              <dt>What I built</dt>
              <dd>
                A reporting product where every number the AI writes is checked against the source data before the
                report goes out. Each figure passes four checks: is it sourced, is anything missing, is the math
                right, are the names right. Numbers that can't be verified get flagged or blocked, and each report
                gets a 0–100 trust score instead of a black-box pass/fail.
              </dd>
            </div>
            <div class="row">
              <dt>Keeping it honest</dt>
              <dd>
                I built a test harness that deliberately tries to trick the AI into making things up. If the trust
                score drops, the build fails.
              </dd>
            </div>
            <div class="row">
              <dt>The product call</dt>
              <dd>
                I first built it to handle dozens of report types. Once the verification engine was proven, I cut the
                scope to three finance reports done well: flux analysis (why numbers changed), budget vs. actual, and
                price-volume-mix (what drove revenue up or down). Narrowing it was the hardest and best decision on
                the project.
              </dd>
            </div>
            <div class="row">
              <dt>How it was built</dt>
              <dd>
                Solo, with AI as the developer and me as product manager. That meant a ticketed backlog, a Strategist
                → Critic → Planner review step for big design decisions, roughly 3,000 automated tests, and security
                reviews.
              </dd>
            </div>
            <div class="row">
              <dt>Built with</dt>
              <dd>
                <ul class="chips">
                  <li>React</li><li>Node</li><li>Supabase</li><li>Claude API</li><li>Vercel + Railway</li>
                </ul>
              </dd>
            </div>
          </dl>
          <a class="btn" href="https://reportforge-kappa.vercel.app" rel="noopener">Visit ReportForge →</a>
          {
            reportforge.length > 0 && (
              <div class="gallery">
                {reportforge.map((g, i) => (
                  <img src={g.src} width={g.width} height={g.height} alt={`ReportForge screenshot ${i + 1}`} loading="lazy" />
                ))}
              </div>
            )
          }
        </article>

        <article class="card case" aria-labelledby="je">
          <h3 class="case-title" id="je"><small>Case study 2</small>AI Job Evaluator</h3>
          <dl class="rows">
            <div class="row">
              <dt>Problem</dt>
              <dd>
                A serious job search is a pipeline problem: dozens of postings, each needing an honest fit assessment
                and tailored materials.
              </dd>
            </div>
            <div class="row">
              <dt>What I built</dt>
              <dd>
                An open-source tool that helps job seekers use AI to evaluate postings honestly instead of applying
                to everything. You set your criteria once. AI then scores each job on fit and odds, explains its
                reasoning, and splits the requirements into what you meet, what you don't, and what you could close.
                It drafts tailored materials for the roles worth pursuing.
              </dd>
            </div>
            <div class="row">
              <dt>Why it matters</dt>
              <dd>
                I've run my own search through it, 37 roles so far. It's the pattern I bring to any team: define the
                rules clearly, let AI handle the volume, keep a human on the final call.
              </dd>
            </div>
          </dl>
          <a class="btn" href="https://github.com/dc803/job-hunt" rel="noopener">View on GitHub →</a>
          {
            jobEvaluator.length > 0 && (
              <div class="gallery">
                {jobEvaluator.map((g, i) => (
                  <img src={g.src} width={g.width} height={g.height} alt={`AI Job Evaluator screenshot ${i + 1}`} loading="lazy" />
                ))}
              </div>
            )
          }
        </article>
      </section>

      <div class="wrap divider" aria-hidden="true"><svg class="sun"><use href="#sun"></use></svg></div>

      <section class="block wrap" id="help" aria-labelledby="help-title">
        <h2 class="title" id="help-title">How I can help your team</h2>
        <div class="cards">
          <article class="card">
            <h3>Run your AI rollout like a program</h3>
            <p>Scope, risks, adoption, and the executive story that keeps it funded.</p>
          </article>
          <article class="card">
            <h3>Prototype fast, then make it dependable</h3>
            <p>Build a working version to prove the value, then scope the real build with engineering.</p>
          </article>
          <article class="card">
            <h3>Put guardrails on AI output</h3>
            <p>Add verification and review steps, so teams in regulated work can trust what AI produces.</p>
          </article>
        </div>
      </section>

      <div class="wrap divider" aria-hidden="true"><svg class="sun"><use href="#sun"></use></svg></div>

      <section class="block wrap" id="experience" aria-labelledby="exp-title">
        <h2 class="title" id="exp-title">Experience</h2>
        <div class="timeline">
          {jobs.map((j) => (
            <article class="t-item">
              <div class="card">
                <h3>{j.role}</h3>
                <p class="meta">
                  {j.org && <span>{j.org}</span>}
                  <span class="badge">{j.dates}</span>
                </p>
                {j.intro && <p class="intro">{j.intro}</p>}
                <ul>
                  {j.bullets.map(([lead, text]) => (
                    <li>{lead && <strong>{lead} </strong>}{text}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
        <p class="edu">Education · BA, Economics, UC Irvine</p>
      </section>

      <div class="wrap divider" aria-hidden="true"><svg class="sun"><use href="#sun"></use></svg></div>

      <section class="block wrap" id="skills" aria-labelledby="skills-title">
        <h2 class="title" id="skills-title">Skills</h2>
        <div class="play">
          <button type="button" class="btn primary big" id="play-blaster" hidden>▶ Play Skill Blaster</button>
          <span>Prefer to blast them? Each one comes with proof.</span>
        </div>
        <div class="skill-groups">
          {skills.map(([group, items]) => (
            <div class="skill-group">
              <h3>{group}</h3>
              <ul class="chips">{items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>

      <div class="wrap divider" aria-hidden="true"><svg class="sun"><use href="#sun"></use></svg></div>

      <section class="block wrap built" id="built" aria-labelledby="built-title">
        <h2 class="title" id="built-title">How this site was built</h2>
        <article class="card">
          <p>
            I designed this site with Claude as my product and design partner, and Claude Code wrote and deployed
            every line. This is how I work now.
          </p>
        </article>
      </section>
    </div>
  </main>

  <footer id="contact">
    <div class="wrap">
      <svg class="sun" aria-hidden="true"><use href="#sun"></use></svg>
      <h2>Let's talk about putting AI to work, safely.</h2>
      <div class="links">
        <a href="mailto:dc@darryncooke.com">dc@darryncooke.com</a>
        <a href="https://linkedin.com/in/darryncooke" rel="noopener">LinkedIn</a>
      </div>
      <small>© {new Date().getFullYear()} Darryn Cooke</small>
    </div>
  </footer>
  <dialog id="blaster" class="blaster" aria-label="Skill Blaster game">
    <button type="button" class="blaster-close" id="blaster-close" aria-label="Close game">✕</button>
    <div class="blaster-stage" id="blaster-stage"><p class="blaster-loading">Loading…</p></div>
  </dialog>

  <script>
    const btn = document.getElementById('play-blaster') as HTMLButtonElement;
    const dlg = document.getElementById('blaster') as HTMLDialogElement;
    const stage = document.getElementById('blaster-stage') as HTMLElement;
    type Game = { resume(): void; pause(): void };
    let game: Game | undefined;

    btn.hidden = false;
    btn.addEventListener('click', async () => {
      dlg.showModal();
      document.body.classList.add('modal-open');
      if (!game) {
        const m = await import('../game/skill-blaster.js');
        game = m.createGame(stage, {
          resumeHref: '/Darryn_Cooke_Resume.pdf',
          close: () => dlg.close(),
        });
      }
      if (dlg.open) game.resume();
    });
    document.getElementById('blaster-close')!.addEventListener('click', () => dlg.close());
    // The dialog has no padding, so a click that targets it is a backdrop click.
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.addEventListener('close', () => {
      game?.pause();
      document.body.classList.remove('modal-open');
      btn.focus();
    });
  </script>
</Layout>
